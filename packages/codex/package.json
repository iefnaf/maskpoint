{
  "name": "@maskpoint/codex",
  "version": "0.1.1",
  "description": "Maskpoint for Codex CLI: pushes preservation instructions into Codex's own compaction prompt where its configuration allows, and re-injects a masked-history artifact after compaction. Assisted augmentation, never replacement.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iefnaf/maskpoint.git",
    "directory": "packages/codex"
  },
  "bugs": "https://github.com/iefnaf/maskpoint/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maskpoint-codex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks/hooks.json": "./hooks/hooks.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "hooks",
    ".codex-plugin",
    "README.md"
  ],
  "scripts": {
    "prepack": "tsc -p ../core/tsconfig.build.json && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@maskpoint/core": "^0.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
