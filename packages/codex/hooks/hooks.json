{
  "description": "Maskpoint: pushes preservation instructions into Codex's own compaction prompt where its config allows, and re-injects a masked-history artifact after compaction. Assisted augmentation — Codex's own compactor is not replaced.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["-c", "node \"$PLUGIN_ROOT/dist/cli.js\" pre-compact"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["-c", "node \"$PLUGIN_ROOT/dist/cli.js\" post-compact"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["-c", "node \"$PLUGIN_ROOT/dist/cli.js\" session-start"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
