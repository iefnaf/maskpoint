{
  "name": "@maskpoint/claude-code",
  "version": "0.1.2",
  "description": "Maskpoint for Claude Code: generates a masked-history artifact before compaction and re-injects it afterwards. Assisted augmentation, never replacement.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iefnaf/maskpoint.git",
    "directory": "packages/claude-code"
  },
  "bugs": "https://github.com/iefnaf/maskpoint/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maskpoint-claude-code": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks/hooks.json": "./hooks/hooks.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "hooks",
    ".claude-plugin",
    "README.md"
  ],
  "scripts": {
    "prepack": "tsc -p ../core/tsconfig.build.json && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@maskpoint/core": "^0.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
