{
  "name": "@maskpoint/claude-code",
  "version": "0.0.0",
  "description": "Maskpoint for Claude Code: generates a masked-history artifact before compaction and re-injects it afterwards. Assisted augmentation, never replacement.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "maskpoint-claude-code": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks/hooks.json": "./hooks/hooks.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "hooks",
    ".claude-plugin",
    "README.md"
  ],
  "dependencies": {
    "@maskpoint/core": "0.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
