{
  "description": "Maskpoint: masks stale tool observations into placeholders before Claude Code compacts, and re-injects the artifact afterward. Assisted augmentation — the host's own compactor is not replaced.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.js", "pre-compact"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.js", "post-compact"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/cli.js", "session-start"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
